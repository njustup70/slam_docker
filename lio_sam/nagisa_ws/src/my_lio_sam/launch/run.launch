<launch>

    <arg name="project" default="my_lio_sam"/>
    
    <!-- Parameters -->
    <rosparam file="$(find my_lio_sam)/config/params.yaml" command="load" />

    <!--- LOAM -->
    <include file="$(find my_lio_sam)/launch/include/module_loam.launch" />

    <!--- Robot State TF -->
    <!-- <include file="$(find my_lio_sam)/launch/include/module_robot_state_publisher.launch" /> -->

    <!-- - Run Navsat
    <include file="$(find my_lio_sam)/launch/include/module_navsat.launch" /> -->

    <!--- Run Rviz-->
    <group if="$(arg rviz)">
        <include file="$(find my_lio_sam)/launch/include/module_rviz.launch" />
    </group>
    <!-- <include file="$(find my_lio_sam)/launch/include/module_rviz.launch" /> -->

</launch>
